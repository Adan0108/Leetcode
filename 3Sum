# 3Sum
#
# Difficulty: Medium
#
# Given an integer array nums, return all triplets:
#
#     [nums[i], nums[j], nums[k]]
#
# where:
#
#     nums[i] + nums[j] + nums[k] == 0
#
# The indices i, j, and k must all be distinct.
#
# The output must not contain duplicate triplets.
# The triplets may be returned in any order.
#
# Example 1:
#
# Input:
# nums = [-1, 0, 1, 2, -1, -4]
#
# Output:
# [[-1, -1, 2], [-1, 0, 1]]
#
# Explanation:
# (-1) + 0 + 1 = 0
# 0 + 1 + (-1) = 0
# (-1) + 2 + (-1) = 0
#
# The distinct triplets are:
# [-1, 0, 1] and [-1, -1, 2]
#
# Example 2:
#
# Input:
# nums = [0, 1, 1]
#
# Output:
# []
#
# Explanation:
# The only possible triplet does not sum to 0.
#
# Example 3:
#
# Input:
# nums = [0, 0, 0]
#
# Output:
# [[0, 0, 0]]
#
# Explanation:
# The only possible triplet sums to 0.
#
# Constraints:
#
# 3 <= len(nums) <= 3000
# -10^5 <= nums[i] <= 10^5

class Solution:
    def threeSum(self, nums: List[int]) -> List[List[int]]:
        #same for two sum sorted but this time 
        #we have to loop for i and 2 pointer for j k (O(N^2))
        #Use a set so no duplicate answer
        nums.sort() #Sort will be O(n log n)
        res = set()

        for i in range(len(nums) - 2):
            j, k = i + 1, len(nums) - 1

            while j < k:
                total = nums[i] + nums[j] + nums[k]

                if total < 0:
                    j += 1
                elif total > 0:
                    k -= 1
                else:
                    res.add((nums[i], nums[j], nums[k]))
                    j += 1
                    k -= 1

        # Convert tuples back into lists
        return [list(triplet) for triplet in res]
        